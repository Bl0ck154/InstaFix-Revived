# Default self-hosted runtime: stateless preview path (no public demo domain required)
# Public origin used by share links, canonical tags, sitemap and previews.
# Set to https://your-neutral-domain.example behind HTTPS proxy.
INSTAFIX_PUBLIC_BASE_URL=http://localhost:3000
INSTAFIX_EXPERIMENT_MODE=stateless_cloudrun
INSTAFIX_EXPERIMENT_LABEL=self-hosted

# Telegram fresh WebPage video ingestion accepts at most exactly 20 MiB.
# The app also clamps any larger configured value back to this boundary.
MAX_INLINE_VIDEO_BYTES=20971520
INSTAFIX_STATELESS_EDGE_TTL_SECONDS=300
INSTAFIX_STATELESS_CDN_EXPIRY_MARGIN_SECONDS=1800
INSTAFIX_PUBLIC_VIDEO_REFRESH_DIRECT=true
INSTAFIX_CACHE_FRESH_TTL_SECONDS=300
INSTAFIX_CACHE_STALE_TTL_SECONDS=1800
INSTAFIX_NEGATIVE_CACHE_TTL_SECONDS=60

# Optional operational Telegram report. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_REPORT_HOUR_UTC=0
REPORT_ADMIN_TOKEN=

# Optional legacy/authenticated fallback mode. The stateless runtime intentionally
# does not depend on cookies; keep cookie material outside Git.
AUTH_HELPER_URL=http://127.0.0.1:3200
PREVIEW_VIDEO_PROXY_ENABLED=false
PREVIEW_VIDEO_PROXY_USER_AGENTS=telegrambot,discordbot,whatsapp,slackbot
PREVIEW_VIDEO_PROXY_TIMEOUT_SECONDS=25
PREVIEW_VIDEO_CDN_REDIRECT_ENABLED=false
PREVIEW_VIDEO_CDN_REDIRECT_USER_AGENTS=telegrambot
INSTAFIX_WEB_GRAPHQL_DOC_ID=25531498899829322
INSTAFIX_MOBILE_GRAPHQL_DOC_ID=8845758582119845
INSTAFIX_MOBILE_GRAPHQL_USER_AGENT=Instagram 273.0.0.16.70 (iPhone15,2; iOS 17_5_1; en_US; en-US; scale=3.00; 1290x2796; 470085518)
INSTAFIX_PUBLIC_PROXY_URLS=
INSTAFIX_PUBLIC_PROXY_ATTEMPTS=2
INSTAFIX_PUBLIC_PROXY_COOLDOWN_SECONDS=600
INSTAFIX_PUBLIC_PROXY_ONLY=false
INSTAFIX_PUBLIC_PROXY_HEDGED=true
INSTAFIX_PUBLIC_PROXY_HEDGE_INITIAL=2
INSTAFIX_PUBLIC_PROXY_HEDGE_DELAY_MS=1500

# Auth helper
AUTH_HELPER_LISTEN=127.0.0.1:3200
AUTH_HELPER_MAX_PER_MINUTE=20
AUTH_HELPER_AUTH_MAX_PER_MINUTE=6
AUTH_HELPER_AUTH_COOLDOWN_SECONDS=21600
AUTH_HELPER_AUTH_CACHE_TTL_SECONDS=86400
AUTH_HELPER_AUTH_NEGATIVE_CACHE_TTL_SECONDS=3600
INSTAGRAM_COOKIE_FILE=/run/secrets/instagram_cookie
INSTAGRAM_COOKIE_DIR=
AUTH_HELPER_ENABLE_VIDEO_PROXY=false
AUTH_HELPER_VIDEO_PROXY_SEND_COOKIE=false
AUTH_HELPER_VIDEO_PROXY_REFRESH_MODE=on_failure
AUTH_HELPER_VIDEO_PROXY_MAX_CONCURRENT=1
AUTH_HELPER_VIDEO_PROXY_MAX_BYTES=50000000
AUTH_HELPER_VIDEO_PROXY_TIMEOUT_SECONDS=20
AUTH_HELPER_VIDEO_PROXY_UPSTREAM_CHUNK_BYTES=262144
AUTH_HELPER_VIDEO_PROXY_UPSTREAM_CHUNK_TIMEOUT_SECONDS=6
